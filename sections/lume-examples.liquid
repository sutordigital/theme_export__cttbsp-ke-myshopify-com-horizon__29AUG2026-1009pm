<section class="lume-section lume-examples" style="--lume-background: {{ section.settings.background }}; --lume-gold: {{ section.settings.accent }};">
  <div class="lume-shell">
    <header class="lume-section__head">
      <h2 class="lume-heading lume-heading--section">{{ section.settings.heading }}</h2>
      {% if section.settings.subheading != blank %}<p class="lume-subheading">{{ section.settings.subheading }}</p>{% endif %}
    </header>
    <div class="lume-examples__grid" role="list">
      {% for block in section.blocks %}
        {% if block.settings.show %}
          <article class="lume-card lume-example" role="listitem" {{ block.shopify_attributes }}>
            <h3 class="lume-card-title">{{ block.settings.title }}</h3>
            <div class="lume-media lume-example__image" style="margin-top:.75rem">
              {% if block.settings.input_image != blank %}
                {{ block.settings.input_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '220, 360, 520, 700', sizes: '(min-width: 990px) 22vw, 46vw', alt: block.settings.input_image.alt }}
              {% else %}
                {% case forloop.index %}
                  {% when 1 %}<img src="{{ 'lume-pet-poodle.webp' | asset_url }}" loading="lazy" width="1200" height="1200" alt="Poodle source photo">
                  {% when 2 %}<img src="{{ 'lume-pet-border-collie.webp' | asset_url }}" loading="lazy" width="1200" height="1200" alt="Border collie source photo">
                  {% when 3 %}<img src="{{ 'lume-pet-golden-retriever.webp' | asset_url }}" loading="lazy" width="1200" height="1200" alt="Golden retriever source photo">
                  {% else %}<img src="{{ 'lume-outline-golden-retriever.webp' | asset_url }}" loading="lazy" width="1200" height="1200" alt="Approved pet portrait artwork">
                {% endcase %}
              {% endif %}
            </div>
            <div class="lume-example__arrow" aria-hidden="true">↓</div>
            <div class="lume-media lume-example__image">
              {% if block.settings.output_image != blank %}
                {{ block.settings.output_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '220, 360, 520, 700', sizes: '(min-width: 990px) 22vw, 46vw', alt: block.settings.output_image.alt }}
              {% else %}
                {% case forloop.index %}
                  {% when 1 %}<img src="{{ 'lume-outline-poodle.webp' | asset_url }}" loading="lazy" width="1200" height="1200" alt="Custom poodle outline portrait">
                  {% when 2 %}<img src="{{ 'lume-outline-border-collie.webp' | asset_url }}" loading="lazy" width="1200" height="1200" alt="Custom border collie outline portrait">
                  {% when 3 %}<img src="{{ 'lume-outline-golden-retriever.webp' | asset_url }}" loading="lazy" width="1200" height="1200" alt="Custom golden retriever outline portrait">
                  {% else %}<img src="{{ 'lume-hero-golden-pendant.webp' | asset_url }}" loading="lazy" width="1120" height="1400" alt="Portrait transformed into a sterling silver pendant">
                {% endcase %}
              {% endif %}
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
    {% if section.settings.closing_line != blank %}<p class="lume-examples__closing">{{ section.settings.closing_line }}</p>{% endif %}
  </div>
</section>

{% schema %}
{
  "name": "LUME outline examples",
  "tag": "section",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "SEE HOW WE CAPTURE THEIR CHARACTER" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Your favorite photo, simplified into clean line art that keeps the features you recognise instantly." },
    { "type": "textarea", "id": "closing_line", "label": "Closing line", "default": "Not photorealistic. Not generic. Just their signature look, turned into something you can wear." },
    { "type": "color", "id": "background", "label": "Background", "default": "#fffaf3" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#b87a20" }
  ],
  "blocks": [
    {
      "type": "example",
      "name": "Before and after",
      "limit": 4,
      "settings": [
        { "type": "checkbox", "id": "show", "label": "Show", "default": true },
        { "type": "text", "id": "title", "label": "Title", "default": "POODLE" },
        { "type": "image_picker", "id": "input_image", "label": "Input photo" },
        { "type": "image_picker", "id": "output_image", "label": "Outline outcome" }
      ]
    }
  ],
  "presets": [
    {
      "name": "LUME outline examples",
      "blocks": [
        { "type": "example", "settings": { "title": "POODLE" } },
        { "type": "example", "settings": { "title": "BORDER COLLIE" } },
        { "type": "example", "settings": { "title": "FLUFFY SMILE" } },
        { "type": "example", "settings": { "title": "YOU & YOUR PET" } }
      ]
    }
  ]
}
{% endschema %}
