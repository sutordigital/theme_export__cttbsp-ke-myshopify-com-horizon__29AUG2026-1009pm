<section class="lume-section lume-comparison" style="--lume-background: {{ section.settings.background }}; --lume-gold: {{ section.settings.accent }};">
  <div class="lume-shell">
    <header class="lume-section__head" style="margin-inline:0;text-align:left">
      <h2 class="lume-heading lume-heading--section">{{ section.settings.heading }}</h2>
      {% if section.settings.subheading != blank %}<p class="lume-subheading">{{ section.settings.subheading }}</p>{% endif %}
    </header>
    <div class="lume-comparison__grid">
      <article class="lume-card lume-compare-card lume-compare-card--featured">
        <div class="lume-compare-card__head">{{ section.settings.lume_heading }}</div>
        <div class="lume-media lume-compare-card__image">
          {% if section.settings.lume_image != blank %}
            {{ section.settings.lume_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '280, 460, 640, 800', sizes: '(min-width: 990px) 27vw, 100vw', alt: section.settings.lume_image.alt }}
          {% else %}
            {{ 'product-1' | placeholder_svg_tag }}
          {% endif %}
        </div>
        <ul class="lume-list">
          {% for block in section.blocks %}
            {% if block.type == 'lume_point' and block.settings.show %}
              <li {{ block.shopify_attributes }}><span class="lume-list__mark">✓</span><span>{{ block.settings.text }}</span></li>
            {% endif %}
          {% endfor %}
        </ul>
      </article>

      <article class="lume-card lume-compare-card">
        <div class="lume-compare-card__head">{{ section.settings.other_heading }}</div>
        <div class="lume-media lume-compare-card__image">
          {% if section.settings.other_image != blank %}
            {{ section.settings.other_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '280, 460, 640, 800', sizes: '(min-width: 990px) 27vw, 100vw', alt: section.settings.other_image.alt }}
          {% else %}
            {{ 'product-2' | placeholder_svg_tag }}
          {% endif %}
        </div>
        <ul class="lume-list">
          {% for block in section.blocks %}
            {% if block.type == 'other_point' and block.settings.show %}
              <li {{ block.shopify_attributes }}><span class="lume-list__mark" style="color:#716b64">×</span><span>{{ block.settings.text }}</span></li>
            {% endif %}
          {% endfor %}
        </ul>
      </article>

      <div class="lume-comparison__images">
        {% for block in section.blocks %}
          {% if block.type == 'support_image' and block.settings.show %}
            <div class="lume-media lume-comparison__image" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '320, 520, 760, 1000', sizes: '(min-width: 990px) 20vw, 50vw', alt: block.settings.image.alt }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag }}
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LUME comparison",
  "tag": "section",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "WHY LUME IS DIFFERENT" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Most custom pet jewellery misses the details. We don’t." },
    { "type": "text", "id": "lume_heading", "label": "LUME card heading", "default": "LUME" },
    { "type": "image_picker", "id": "lume_image", "label": "LUME comparison image" },
    { "type": "text", "id": "other_heading", "label": "Competitor card heading", "default": "OTHER BRANDS" },
    { "type": "image_picker", "id": "other_image", "label": "Competitor comparison image" },
    { "type": "color", "id": "background", "label": "Background", "default": "#f4eadf" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#b87a20" }
  ],
  "blocks": [
    { "type": "lume_point", "name": "LUME benefit", "limit": 5, "settings": [
      { "type": "checkbox", "id": "show", "label": "Show", "default": true },
      { "type": "text", "id": "text", "label": "Text", "default": "Looks like your pet’s unique self" }
    ] },
    { "type": "other_point", "name": "Other brand drawback", "limit": 5, "settings": [
      { "type": "checkbox", "id": "show", "label": "Show", "default": true },
      { "type": "text", "id": "text", "label": "Text", "default": "Generic or hard to recognize" }
    ] },
    { "type": "support_image", "name": "Supporting product image", "limit": 2, "settings": [
      { "type": "checkbox", "id": "show", "label": "Show", "default": true },
      { "type": "image_picker", "id": "image", "label": "Image" }
    ] }
  ],
  "presets": [
    {
      "name": "LUME comparison",
      "blocks": [
        { "type": "lume_point", "settings": { "text": "Looks like your pet’s unique self" } },
        { "type": "lume_point", "settings": { "text": "Portraits approved before made" } },
        { "type": "lume_point", "settings": { "text": "Real likeness check at every order" } },
        { "type": "lume_point", "settings": { "text": "925 Sterling Silver, built to last" } },
        { "type": "lume_point", "settings": { "text": "Real people. Real happiness." } },
        { "type": "other_point", "settings": { "text": "Generic or hard to recognize" } },
        { "type": "other_point", "settings": { "text": "No approval, no portrait" } },
        { "type": "other_point", "settings": { "text": "Risk of no likeness" } },
        { "type": "other_point", "settings": { "text": "Cheap materials" } },
        { "type": "other_point", "settings": { "text": "Slow or no response" } },
        { "type": "support_image" }, { "type": "support_image" }
      ]
    }
  ]
}
{% endschema %}
