<section
  class="lume-section lume-section--tight lume-trust"
  style="--lume-background: {{ section.settings.background }}; --lume-gold: {{ section.settings.accent }};"
>
  <div class="lume-shell">
    {% if section.settings.heading != blank %}<h2 class="lume-eyebrow" style="text-align:center">{{ section.settings.heading }}</h2>{% endif %}
    <div class="lume-trust__grid" role="list">
      {% for block in section.blocks %}
        {% if block.settings.show %}
          <div class="lume-trust__item" role="listitem" {{ block.shopify_attributes }}>
            <span class="lume-icon lume-trust__icon" aria-hidden="true">{{ block.settings.icon }}</span>
            <h3 class="lume-card-title">{{ block.settings.title }}</h3>
            <p class="lume-card-copy">{{ block.settings.text }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LUME trust strip",
  "tag": "section",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "TRUSTED BY PET PARENTS WHO EXPECT MORE" },
    { "type": "color", "id": "background", "label": "Background", "default": "#fffaf3" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#b87a20" }
  ],
  "blocks": [
    {
      "type": "trust_point",
      "name": "Trust point",
      "limit": 5,
      "settings": [
        { "type": "checkbox", "id": "show", "label": "Show", "default": true },
        { "type": "text", "id": "icon", "label": "Icon or symbol", "default": "✦" },
        { "type": "text", "id": "title", "label": "Title", "default": "925 Sterling Silver" },
        { "type": "text", "id": "text", "label": "Supporting line", "default": "Never fades, made to last." }
      ]
    }
  ],
  "presets": [
    {
      "name": "LUME trust strip",
      "blocks": [
        { "type": "trust_point", "settings": { "icon": "✦", "title": "925 Sterling Silver", "text": "Never fades, made to last." } },
        { "type": "trust_point", "settings": { "icon": "✓", "title": "Portraits Approved", "text": "You approve before we create." } },
        { "type": "trust_point", "settings": { "icon": "↻", "title": "One Free Revision", "text": "Get it right, with no extra cost." } },
        { "type": "trust_point", "settings": { "icon": "✓", "title": "Final Likeness Check", "text": "We check and sign off your approval." } },
        { "type": "trust_point", "settings": { "icon": "◇", "title": "Risk-Free Guarantee", "text": "We make it right, always." } }
      ]
    }
  ]
}
{% endschema %}
