<section class="lume-section lume-testimonials" style="--lume-background: {{ section.settings.background }}; --lume-gold: {{ section.settings.accent }};">
  <div class="lume-shell">
    <header class="lume-section__head">
      <h2 class="lume-heading lume-heading--section">{{ section.settings.heading }}</h2>
      {% if section.settings.subheading != blank %}<p class="lume-subheading">{{ section.settings.subheading }}</p>{% endif %}
    </header>
    <div class="lume-card-row" style="--lume-columns: 3" role="list">
      {% for block in section.blocks %}
        {% if block.settings.show %}
          <article class="lume-card lume-testimonial" role="listitem" {{ block.shopify_attributes }}>
            <div class="lume-media lume-testimonial__avatar">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 180, 240', sizes: '76px', alt: block.settings.image.alt }}
              {% else %}
                {% case forloop.index %}
                  {% when 1 %}<img src="{{ 'lume-pet-golden-retriever.webp' | asset_url }}" loading="lazy" width="240" height="240" alt="Golden retriever">
                  {% when 2 %}<img src="{{ 'lume-pet-poodle.webp' | asset_url }}" loading="lazy" width="240" height="240" alt="Poodle">
                  {% else %}<img src="{{ 'lume-pet-border-collie.webp' | asset_url }}" loading="lazy" width="240" height="240" alt="Border collie">
                {% endcase %}
              {% endif %}
            </div>
            <div>
              {% if block.settings.is_placeholder %}
                <div class="lume-placeholder-label">TESTIMONIAL PLACEHOLDER</div>
                <blockquote class="lume-testimonial__quote">{{ block.settings.quote }}</blockquote>
                <div class="lume-testimonial__name">{{ block.settings.name }}</div>
              {% else %}
                <div class="lume-stars" aria-label="5 stars">★★★★★</div>
                <blockquote class="lume-testimonial__quote">“{{ block.settings.quote }}”</blockquote>
                <div class="lume-testimonial__name">— {{ block.settings.name }}</div>
              {% endif %}
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LUME testimonials",
  "tag": "section",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "LOVED BY PET PARENTS" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Verified customer stories will be added here." },
    { "type": "color", "id": "background", "label": "Background", "default": "#fffaf3" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#b87a20" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "limit": 6,
      "settings": [
        { "type": "checkbox", "id": "show", "label": "Show", "default": true },
        { "type": "checkbox", "id": "is_placeholder", "label": "Mark as placeholder", "default": true },
        { "type": "image_picker", "id": "image", "label": "Customer or pet image" },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Verified customer quote to be supplied." },
        { "type": "text", "id": "name", "label": "Customer name", "default": "Customer name to be supplied" }
      ]
    }
  ],
  "presets": [
    {
      "name": "LUME testimonials",
      "blocks": [
        { "type": "testimonial", "settings": { "is_placeholder": true, "quote": "Verified customer quote to be supplied.", "name": "Customer name to be supplied" } },
        { "type": "testimonial", "settings": { "is_placeholder": true, "quote": "Verified customer quote to be supplied.", "name": "Customer name to be supplied" } },
        { "type": "testimonial", "settings": { "is_placeholder": true, "quote": "Verified customer quote to be supplied.", "name": "Customer name to be supplied" } }
      ]
    }
  ]
}
{% endschema %}
