<section class="lume-section lume-process" style="--lume-background: {{ section.settings.background }};">
  <div class="lume-shell">
    <header class="lume-section__head">
      <h2 class="lume-heading lume-heading--section">{{ section.settings.heading }}</h2>
      {% if section.settings.subheading != blank %}<p class="lume-subheading">{{ section.settings.subheading }}</p>{% endif %}
    </header>
    <div class="lume-card-row" style="--lume-columns: 5" role="list" aria-label="{{ section.settings.heading | escape }}">
      {% for block in section.blocks %}
        {% if block.settings.show %}
          <article class="lume-card lume-process__card" role="listitem" {{ block.shopify_attributes }}>
            <span class="lume-process__number">{{ block.settings.number }}</span>
            <h3 class="lume-card-title">{{ block.settings.title }}</h3>
            <div class="lume-media lume-process__media">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '260, 420, 560, 720', sizes: '(min-width: 990px) 18vw, 78vw', alt: block.settings.image.alt }}
              {% else %}
                {{ 'image' | placeholder_svg_tag }}
              {% endif %}
            </div>
            <p class="lume-card-copy">{{ block.settings.text }}</p>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LUME how it works",
  "tag": "section",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "HOW IT WORKS" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "From your photo to a keepsake you’ll treasure forever." },
    { "type": "color", "id": "background", "label": "Background", "default": "#f8f2e9" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Process step",
      "limit": 5,
      "settings": [
        { "type": "checkbox", "id": "show", "label": "Show", "default": true },
        { "type": "text", "id": "number", "label": "Step number", "default": "1" },
        { "type": "text", "id": "title", "label": "Title", "default": "YOU UPLOAD YOUR PHOTO" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "Choose your favorite clear photo." }
      ]
    }
  ],
  "presets": [
    {
      "name": "LUME how it works",
      "blocks": [
        { "type": "step", "settings": { "number": "1", "title": "YOU UPLOAD YOUR PHOTO", "text": "Choose your favorite clear photo." } },
        { "type": "step", "settings": { "number": "2", "title": "WE CREATE THE PORTRAIT", "text": "Our artist captures your pet’s signature features in clean line art." } },
        { "type": "step", "settings": { "number": "3", "title": "YOU REVIEW & APPROVE", "text": "Request one free revision or approve when it’s perfect." } },
        { "type": "step", "settings": { "number": "4", "title": "WE CRAFT YOUR NECKLACE", "text": "Made in 925 Sterling Silver and crafted with care." } },
        { "type": "step", "settings": { "number": "5", "title": "WE CHECK & SHIP TO YOU", "text": "Final likeness check, beautiful packaging, and on its way." } }
      ]
    }
  ]
}
{% endschema %}
