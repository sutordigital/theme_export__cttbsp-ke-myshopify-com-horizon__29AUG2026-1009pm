<section class="lume-section lume-process" style="--lume-background: {{ section.settings.background }};">
  <div class="lume-shell">
    <header class="lume-section__head">
      <h2 class="lume-heading lume-heading--section">{{ section.settings.heading }}</h2>
      {% if section.settings.subheading != blank %}<p class="lume-subheading">{{ section.settings.subheading }}</p>{% endif %}
    </header>
    <div class="lume-card-row" style="--lume-columns: 5" role="list" aria-label="{{ section.settings.heading | escape }}">
      {% for block in section.blocks %}
        {% if block.settings.show %}
          <article class="lume-card lume-process__card" role="listitem" {{ block.shopify_attributes }}>
            <span class="lume-process__number">{{ block.settings.number }}</span>
            <h3 class="lume-card-title">{{ block.settings.title }}</h3>
            <div class="lume-media lume-process__media">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '260, 420, 560, 720', sizes: '(min-width: 990px) 18vw, 78vw', alt: block.settings.image.alt }}
              {% else %}
                {% case forloop.index %}
                  {% when 1 %}<img src="{{ 'lume-pet-golden-retriever.webp' | asset_url }}" loading="lazy" width="1200" height="1200" alt="Golden retriever source photo">
                  {% when 2 %}<img src="{{ 'lume-outline-golden-retriever.webp' | asset_url }}" loading="lazy" width="1200" height="1200" alt="Golden retriever custom portrait artwork">
                  {% when 3 %}<img src="{{ 'lume-outline-golden-retriever.webp' | asset_url }}" loading="lazy" width="1200" height="1200" alt="Portrait artwork ready for customer approval">
                  {% when 4 %}<img src="{{ 'lume-product-cat-pendant.webp' | asset_url }}" loading="lazy" width="1200" height="1200" alt="Finished sterling silver cat portrait necklace">
                  {% else %}<img src="{{ 'lume-packaging-lume-box.webp' | asset_url }}" loading="lazy" width="1200" height="1200" alt="LUME jewelry gift box ready to ship">
                {% endcase %}
              {% endif %}
            </div>
            <p class="lume-card-copy">{{ block.settings.text }}</p>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LUME how it works",
  "tag": "section",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "FROM PHOTO TO PORTRAIT IN 5 SIMPLE STEPS" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "You approve the artwork before we make your necklace." },
    { "type": "color", "id": "background", "label": "Background", "default": "#f8f2e9" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Process step",
      "limit": 5,
      "settings": [
        { "type": "checkbox", "id": "show", "label": "Show", "default": true },
        { "type": "text", "id": "number", "label": "Step number", "default": "1" },
        { "type": "text", "id": "title", "label": "Title", "default": "UPLOAD YOUR FAVORITE PHOTO" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "Choose a clear photo that shows their face and signature features." }
      ]
    }
  ],
  "presets": [
    {
      "name": "LUME how it works",
      "blocks": [
        { "type": "step", "settings": { "number": "1", "title": "UPLOAD YOUR FAVORITE PHOTO", "text": "Choose a clear photo that shows their face and signature features." } },
        { "type": "step", "settings": { "number": "2", "title": "WE CREATE YOUR LUME PORTRAIT", "text": "We turn their expression, shape and little quirks into clean line art." } },
        { "type": "step", "settings": { "number": "3", "title": "YOU REVIEW & APPROVE", "text": "Love it? Approve it. Want an adjustment? One complimentary revision is included." } },
        { "type": "step", "settings": { "number": "4", "title": "WE CRAFT YOUR NECKLACE", "text": "Your approved portrait is made into a 925 sterling silver keepsake." } },
        { "type": "step", "settings": { "number": "5", "title": "WE CHECK & SHIP", "text": "We compare the finished piece with your approved portrait before sending it your way." } }
      ]
    }
  ]
}
{% endschema %}
