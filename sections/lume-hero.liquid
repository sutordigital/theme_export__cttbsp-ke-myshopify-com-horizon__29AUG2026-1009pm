{{ 'lume-landing.css' | asset_url | stylesheet_tag }}

<section
  class="lume-section lume-hero"
  style="--lume-background: {{ section.settings.background }}; --lume-gold: {{ section.settings.accent }};"
  data-lume-page
>
  <div class="lume-shell lume-hero__grid">
    <div class="lume-hero__copy">
      {% if section.settings.eyebrow != blank %}<p class="lume-eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      <h1 class="lume-heading">{{ section.settings.heading }}</h1>

      {% assign carousel_product = section.settings.carousel_product %}
      {% if section.settings.show_mobile_carousel and carousel_product != blank and carousel_product.images.size > 0 %}
        <lume-mobile-product-carousel class="lume-mobile-product-carousel" role="region" aria-label="{{ carousel_product.title | escape }} product images">
          <div class="lume-mobile-product-carousel__track" role="list" data-carousel-track>
            {% for image in carousel_product.images %}
              {% assign carousel_alt = image.alt | default: carousel_product.title %}
              <figure
                class="lume-mobile-product-carousel__slide"
                id="LumeMobileCarouselSlide-{{ section.id }}-{{ forloop.index0 }}"
                role="listitem"
                data-carousel-slide
              >
                {{ image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '360, 540, 720, 1000', sizes: '92vw', alt: carousel_alt }}
              </figure>
            {% endfor %}
          </div>

          <div class="lume-mobile-product-carousel__thumbnails" aria-label="Choose a product image">
            {% for image in carousel_product.images %}
              {% assign carousel_alt = image.alt | default: carousel_product.title %}
              <button
                class="lume-mobile-product-carousel__thumbnail{% if forloop.first %} is-active{% endif %}"
                type="button"
                aria-label="View product image {{ forloop.index }}"
                aria-controls="LumeMobileCarouselSlide-{{ section.id }}-{{ forloop.index0 }}"
                aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
                data-carousel-thumbnail
              >
                {{ image | image_url: width: 180 | image_tag: loading: 'lazy', widths: '90, 135, 180', sizes: '68px', alt: carousel_alt }}
              </button>
            {% endfor %}
          </div>
        </lume-mobile-product-carousel>
      {% endif %}

      {% if section.settings.text != blank %}<div class="lume-subheading lume-hero__text">{{ section.settings.text }}</div>{% endif %}

      <div class="lume-benefits" role="list">
        {% for block in section.blocks %}
          {% if block.type == 'benefit' and block.settings.show %}
            {% case forloop.index %}
              {% when 1 %}{% assign fallback_illustration = 'lume-icon-likeness.webp' %}
              {% when 2 %}{% assign fallback_illustration = 'lume-icon-portrait-approval.webp' %}
              {% else %}{% assign fallback_illustration = 'lume-icon-handcrafted-silver.webp' %}
            {% endcase %}
            <div class="lume-benefit" role="listitem" {{ block.shopify_attributes }}>
              <span class="lume-benefit__illustration" aria-hidden="true">
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 320 | image_tag: loading: 'lazy', widths: '160, 240, 320', sizes: '(min-width: 750px) 112px, 76px', alt: '' }}
                {% else %}
                  <img src="{{ fallback_illustration | asset_url }}" loading="lazy" width="320" height="320" alt="">
                {% endif %}
              </span>
              <span class="lume-benefit__copy">
                <strong>{{ block.settings.text }}</strong>
                {% if block.settings.supporting_text != blank %}<small>{{ block.settings.supporting_text }}</small>{% endif %}
              </span>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <a class="lume-button" href="{{ section.settings.button_link | default: '#lume-final-cta' }}">
        {{ section.settings.button_label }}
      </a>

      {% if section.settings.show_review %}
        <div class="lume-review-mini">
          <div class="lume-avatars" aria-hidden="true">
            {% for block in section.blocks %}
              {% if block.type == 'avatar' %}
                <span class="lume-avatar" {{ block.shopify_attributes }}>
                  {% if block.settings.image != blank %}
                    {{ block.settings.image | image_url: width: 96 | image_tag: loading: 'lazy', widths: '64, 96', sizes: '34px', alt: '' }}
                  {% elsif forloop.index == 4 %}
                    <img src="{{ 'lume-pet-golden-retriever.webp' | asset_url }}" loading="lazy" width="96" height="96" alt="">
                  {% elsif forloop.index == 5 %}
                    <img src="{{ 'lume-pet-poodle.webp' | asset_url }}" loading="lazy" width="96" height="96" alt="">
                  {% else %}
                    <img src="{{ 'lume-pet-border-collie.webp' | asset_url }}" loading="lazy" width="96" height="96" alt="">
                  {% endif %}
                </span>
              {% endif %}
            {% endfor %}
          </div>
          <div>
            <div class="lume-review-mini__rating"><span class="lume-stars" aria-label="5 stars">★★★★★</span> {{ section.settings.rating_text }}</div>
            <div class="lume-review-mini__quote">“{{ section.settings.review_quote }}”</div>
          </div>
        </div>
      {% endif %}
    </div>

    <div class="lume-hero__visual" aria-label="{{ section.settings.visual_label | escape }}">
      <div class="lume-media lume-hero__main">
        {% if section.settings.main_image != blank %}
          {{ section.settings.main_image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1500, 1800', sizes: '(min-width: 990px) 52vw, 92vw', alt: section.settings.main_image.alt }}
        {% else %}
          <img src="{{ 'lume-hero-golden-pendant.webp' | asset_url }}" loading="eager" fetchpriority="high" width="1120" height="1400" alt="Custom golden retriever portrait necklace in sterling silver">
        {% endif %}
      </div>
      <div class="lume-media lume-hero__pet">
        {% if section.settings.pet_image != blank %}
          {{ section.settings.pet_image | image_url: width: 500 | image_tag: loading: 'eager', widths: '240, 360, 500', sizes: '(min-width: 990px) 190px, 28vw', alt: section.settings.pet_image.alt }}
        {% else %}
          <img src="{{ 'lume-pet-golden-retriever-full-body-v2.jpg' | asset_url }}" loading="eager" width="1254" height="1254" alt="Full-body golden retriever source photo matching the pendant pose">
        {% endif %}
      </div>
      <div class="lume-media lume-hero__detail">
        {% if section.settings.detail_image != blank %}
          {{ section.settings.detail_image | image_url: width: 420 | image_tag: loading: 'lazy', widths: '180, 300, 420', sizes: '(min-width: 990px) 155px, 23vw', alt: section.settings.detail_image.alt }}
        {% else %}
          <img src="{{ 'lume-necklace-worn-v2.jpg' | asset_url }}" loading="lazy" width="1254" height="1254" alt="Woman wearing a custom golden retriever portrait necklace">
        {% endif %}
      </div>
      {% if section.settings.note != blank %}<div class="lume-hero__note">{{ section.settings.note }}</div>{% endif %}
    </div>
  </div>
</section>

<script>
  if (!customElements.get('lume-mobile-product-carousel')) {
    customElements.define('lume-mobile-product-carousel', class extends HTMLElement {
      connectedCallback() {
        const track = this.querySelector('[data-carousel-track]');
        const slides = Array.from(this.querySelectorAll('[data-carousel-slide]'));
        const thumbnails = Array.from(this.querySelectorAll('[data-carousel-thumbnail]'));

        if (!track || slides.length === 0 || thumbnails.length === 0) return;

        const setActiveThumbnail = (activeIndex) => {
          thumbnails.forEach((thumbnail, index) => {
            const isActive = index === activeIndex;
            thumbnail.classList.toggle('is-active', isActive);
            thumbnail.setAttribute('aria-pressed', isActive ? 'true' : 'false');
          });
        };

        thumbnails.forEach((thumbnail, index) => {
          thumbnail.addEventListener('click', () => {
            const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            slides[index].scrollIntoView({
              behavior: reduceMotion ? 'auto' : 'smooth',
              block: 'nearest',
              inline: 'center'
            });
            setActiveThumbnail(index);
          });
        });

        let scrollFrame;
        track.addEventListener('scroll', () => {
          cancelAnimationFrame(scrollFrame);
          scrollFrame = requestAnimationFrame(() => {
            const trackBounds = track.getBoundingClientRect();
            const trackCenter = trackBounds.left + (trackBounds.width / 2);
            let activeIndex = 0;
            let closestDistance = Number.POSITIVE_INFINITY;

            slides.forEach((slide, index) => {
              const slideBounds = slide.getBoundingClientRect();
              const slideCenter = slideBounds.left + (slideBounds.width / 2);
              const distance = Math.abs(trackCenter - slideCenter);
              if (distance < closestDistance) {
                closestDistance = distance;
                activeIndex = index;
              }
            });

            setActiveThumbnail(activeIndex);
          });
        }, { passive: true });
      }
    });
  }
</script>

{% schema %}
{
  "name": "LUME hero",
  "tag": "section",
  "class": "lume-page",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE DETAILS THAT MAKE THEM THEM." },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "A portrait of your pet, made wearable." },
    { "type": "checkbox", "id": "show_mobile_carousel", "label": "Show product carousel on mobile", "default": true },
    { "type": "product", "id": "carousel_product", "label": "Mobile carousel product" },
    { "type": "richtext", "id": "text", "label": "Supporting text", "default": "<p>Turn your favorite photo into a custom line-art portrait, crafted into a sterling silver necklace made to feel unmistakably like them.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "CREATE MY PORTRAIT →" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "show_review", "label": "Show review row", "default": true },
    { "type": "text", "id": "rating_text", "label": "Rating summary", "default": "4.9/5 from 1,500+ pet parents" },
    { "type": "text", "id": "review_quote", "label": "Review quote", "default": "Looks exactly like him. I wear it every day." },
    { "type": "header", "content": "Visual composition" },
    { "type": "image_picker", "id": "main_image", "label": "Main product image" },
    { "type": "image_picker", "id": "pet_image", "label": "Pet input image" },
    { "type": "image_picker", "id": "detail_image", "label": "Outcome detail image" },
    { "type": "text", "id": "visual_label", "label": "Visual alt label", "default": "Custom pet portrait necklace shown with the source pet photo" },
    { "type": "text", "id": "note", "label": "Handwritten note", "default": "Made to be yours, every day" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Background", "default": "#f7efe5" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#b87a20" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "limit": 3,
      "settings": [
        { "type": "checkbox", "id": "show", "label": "Show", "default": true },
        { "type": "image_picker", "id": "image", "label": "Custom illustration" },
        { "type": "text", "id": "text", "label": "Title", "default": "Recognisable at a glance" },
        { "type": "textarea", "id": "supporting_text", "label": "Supporting text", "default": "Captures the features that make them uniquely yours." }
      ]
    },
    {
      "type": "avatar",
      "name": "Review avatar",
      "limit": 3,
      "settings": [{ "type": "image_picker", "id": "image", "label": "Image" }]
    }
  ],
  "presets": [
    {
      "name": "LUME hero",
      "blocks": [
        { "type": "benefit", "settings": { "text": "Recognisable at a glance", "supporting_text": "Captures the features that make them uniquely yours." } },
        { "type": "benefit", "settings": { "text": "Approve your portrait first", "supporting_text": "See it before your necklace goes into production." } },
        { "type": "benefit", "settings": { "text": "925 Sterling Silver", "supporting_text": "Made to be worn, loved, and kept." } },
        { "type": "avatar" }, { "type": "avatar" }, { "type": "avatar" }
      ]
    }
  ]
}
{% endschema %}
