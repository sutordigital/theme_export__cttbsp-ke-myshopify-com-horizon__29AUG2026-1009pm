<section
  id="lume-final-cta"
  class="lume-section lume-final"
  style="--lume-background: {{ section.settings.background }}; --lume-gold: {{ section.settings.accent }};"
>
  <div class="lume-shell lume-final__grid">
    <div class="lume-media lume-final__image">
      {% if section.settings.left_image != blank %}
        {{ section.settings.left_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '360, 560, 800, 1000, 1200', sizes: '(min-width: 990px) 33vw, 50vw', alt: section.settings.left_image.alt }}
      {% else %}
        <img src="{{ 'lume-lifestyle-woman-golden-retriever.webp' | asset_url }}" loading="lazy" width="1536" height="1024" alt="Pet parent embracing her golden retriever while wearing a custom necklace">
      {% endif %}
    </div>
    <div class="lume-final__copy">
      {% if section.settings.eyebrow != blank %}<p class="lume-eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      <h2 class="lume-heading lume-heading--section">{{ section.settings.heading }}</h2>
      <div style="margin-top:1.2rem">
        <a class="lume-button" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label }}</a>
      </div>
      {% if section.settings.support != blank %}<div class="lume-final__support">{{ section.settings.support }}</div>{% endif %}
    </div>
    <div class="lume-media lume-final__image">
      {% if section.settings.right_image != blank %}
        {{ section.settings.right_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '360, 560, 800, 1000, 1200', sizes: '(min-width: 990px) 33vw, 50vw', alt: section.settings.right_image.alt }}
      {% else %}
        <img src="{{ 'lume-product-cat-pendant.webp' | asset_url }}" loading="lazy" width="1200" height="1200" alt="Custom cat portrait necklace in sterling silver">
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LUME final CTA",
  "tag": "section",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Supporting line", "default": "More than a photo. A piece of them, always with you." },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Create a necklace you’ll carry their memory with you." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "CREATE YOURS NOW →" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "support", "label": "Guarantee line", "default": "60-DAY GUARANTEE. WE MAKE IT RIGHT. ALWAYS." },
    { "type": "image_picker", "id": "left_image", "label": "Emotional lifestyle image" },
    { "type": "image_picker", "id": "right_image", "label": "Product image" },
    { "type": "color", "id": "background", "label": "Background", "default": "#efe2d2" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#b87a20" }
  ],
  "presets": [{ "name": "LUME final CTA" }]
}
{% endschema %}
